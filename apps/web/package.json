{
  "name": "@the-others/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/link-test-react.mjs && vitest run",
    "test:watch": "node scripts/link-test-react.mjs && vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "db:start": "supabase start",
    "db:push": "supabase db push --linked",
    "db:types": "supabase gen types typescript --linked > src/shared/api/supabase/types.ts",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5.100.1",
    "@the-others/webview-protocol": "workspace:*",
    "axios": "1.15.2",
    "class-variance-authority": "^0.7.1",
    "dayjs": "^1.11.20",
    "dompurify": "^3.4.1",
    "js-cookie": "^3.0.5",
    "jwt-decode": "^4.0.0",
    "lodash-es": "4.18.1",
    "marked": "^18.0.4",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-calendar": "^6.0.1",
    "react-clock": "^6.0.0",
    "react-datetime-picker": "^7.0.2",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.100.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.1.1",
    "npm-check-updates": "^21.0.3",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
