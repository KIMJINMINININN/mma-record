# e2e (Playwright) 전용 — 실제 값은 .env.test(gitignore)에 둔다. 채팅/커밋 금지.
#
# 운영 사용자 계정이 아니라 "전용 테스트 계정"으로 로그인한다.
# Supabase에서 미리 만들고 (이메일 확인이 켜져 있으면) 확인까지 끝낸 계정을 쓸 것.
# 이 계정에는 e2e가 세션 등 테스트 데이터를 쌓는다(일회용 계정 권장).
E2E_USER_EMAIL=test@example.com
E2E_USER_PASSWORD=change-me

# (선택) 외부 대상(배포 사이트 등)을 테스트할 때만 지정.
# 미설정이면 Playwright가 로컬 next dev(localhost:3000, .env.local의 실 Supabase)를 자동 기동한다.
# E2E_BASE_URL=https://your-project.vercel.app
